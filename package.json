{
  "name": "lizard-ui",
  "version": "0.1.1",
  "description": "Lizard UI — modern, stylish, minimalist React components. ESM/CJS package for Vite, Bun, and other bundlers.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./styles/themes.css": "./dist/styles/themes.css"
  },
  "files": [
    "dist",
    "docs",
    "knowledge",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "node scripts/lint.cjs \"src/**/*.{ts,tsx}\"",
    "lint:fix": "node scripts/lint.cjs \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "build:site": "vite build",
    "dev": "vite",
    "dev:all": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:test": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1 -Task test",
    "dev:build": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1 -Task build",
    "dev:lint": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1 -Task lint",
    "dev:typecheck": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1 -Task typecheck",
    "prepublishOnly": "bun run build && bun run test && bun run lint && bun run typecheck",
    "setup": "node scripts/setup.js",
    "setup:ps": "pwsh -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:ps": "pwsh -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:ps:minor": "pwsh -ExecutionPolicy Bypass -File scripts/release.ps1 -VersionType minor",
    "release:ps:major": "pwsh -ExecutionPolicy Bypass -File scripts/release.ps1 -VersionType major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizard-ui/lizard-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lizard-ui/lizard-ui#readme",
  "bugs": {
    "url": "https://github.com/lizard-ui/lizard-ui/issues"
  },
  "keywords": [
    "lizard-ui",
    "react",
    "components",
    "ui",
    "design-system",
    "minimal",
    "minimalist",
    "typescript",
    "vite",
    "bun",
    "esm",
    "glassmorphism",
    "tailwindcss",
    "shadcn",
    "okf"
  ],
  "author": {
    "name": "charlite",
    "email": "38315638+charlite@users.noreply.github.com",
    "url": "https://github.com/charlite"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0",
    "lucide-react": "^0.263.0",
    "react-markdown": "^9.0.0 || ^10.0.0",
    "remark-gfm": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^26.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.1.0",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rollup": "^4.60.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0"
  }
}
